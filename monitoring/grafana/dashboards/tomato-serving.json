{
  "uid": "tomato-serving",
  "title": "Tomato Model Serving",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "tomato",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Serving UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"tomato-serving\"}",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    },
    {
      "id": 2,
      "title": "Prediction count",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tomato_serving_predictions_total{job=\"tomato-serving\"})",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    },
    {
      "id": 3,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(tomato_serving_requests_total{job=\"tomato-serving\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    },
    {
      "id": 4,
      "title": "Predictions by class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (disease_class) (tomato_serving_predictions_total{job=\"tomato-serving\"})",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    },
    {
      "id": 5,
      "title": "Inference latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tomato_serving_inference_latency_seconds_bucket{job=\"tomato-serving\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Latency rates need predictions during the selected time window."
    },
    {
      "id": 6,
      "title": "Mean inference latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tomato_serving_inference_latency_seconds_sum{job=\"tomato-serving\"}[$__rate_interval])) / sum(rate(tomato_serving_inference_latency_seconds_count{job=\"tomato-serving\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Latency rates need predictions during the selected time window."
    },
    {
      "id": 7,
      "title": "Errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tomato-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tomato_serving_errors_total{job=\"tomato-serving\"}[$__rate_interval])) or (0 * max(up{job=\"tomato-serving\"}))",
          "legendFormat": "{{endpoint}} {{disease_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    }
  ]
}
